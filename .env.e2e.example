# ─────────────────────────────────────────────────────────────────────────────
# Config de los tests E2E contra el backend REAL (Railway).
#
#   1. Copiá este archivo a  .env.e2e   (cp .env.e2e.example .env.e2e)
#   2. Completá los valores en .env.e2e  — NO acá
#   3. .env.e2e está gitignoreado; este .example se commitea, así que
#      nunca pongas credenciales reales en este archivo.
#
# Los specs de tests/live/ leen estas variables. Sin un valor, el test
# correspondiente queda "skipped" (no falla).
# ─────────────────────────────────────────────────────────────────────────────

# Base del backend REST. Igual al VITE_API_URL del .env pero SIN barra final.
E2E_API_URL=https://backend-cooperativa-production.up.railway.app/api

# Prefijo de todo lo que crean los tests (origen/destino/observaciones del
# viaje). El script de limpieza borra por este prefijo. No lo cambies sin avisar.
E2E_PREFIX=E2E-


# ── CUENTAS DE QA ────────────────────────────────────────────────────────────
# Una por rol. Requisitos de cada cuenta:
#   · el usuario ya cambió la contraseña en el primer login
#     (mustChangePassword = false), si no la app redirige a cambiar clave
#     y el test no puede navegar.
#   · el rol del usuario en el backend coincide exactamente con el de abajo.

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_CARRIER_EMAIL=
E2E_CARRIER_PASSWORD=

E2E_PLAYERO_EMAIL=
E2E_PLAYERO_PASSWORD=

E2E_GAS_STATION_EMAIL=
E2E_GAS_STATION_PASSWORD=

E2E_LOGISTICS_EMAIL=
E2E_LOGISTICS_PASSWORD=

E2E_TECHNICAL_CENTER_EMAIL=
E2E_TECHNICAL_CENTER_PASSWORD=

E2E_CONTROL_VIAJES_EMAIL=
E2E_CONTROL_VIAJES_PASSWORD=


# ── DATOS SEED (OPCIONAL) ────────────────────────────────────────────────────
# Normalmente NO hace falta completar nada acá: la suite descubre sola el
# transportista (por el carrierId de la cuenta CARRIER), su primer chofer y su
# primer camión disponible/habilitado, y el grupo "General".
#
# Completá alguno de estos SOLO para forzar un dato concreto (p. ej. si el
# transportista tiene varios camiones y querés uno en particular). Lo que
# quede vacío se resuelve automáticamente.

E2E_CARRIER_ID=
E2E_CARRIER_NAME=

# E2E_GROUP_ID: solo si NO tenés una cuenta ADMIN (el endpoint /groups es
# ADMIN-only en este backend). Con ADMIN cargada, se resuelve solo.
E2E_GROUP_ID=
E2E_GROUP_NAME=General
E2E_GROUP_RATE=500000

E2E_DRIVER_ID=
E2E_DRIVER_NAME=
E2E_DRIVER_DNI=

E2E_TRUCK_ID=
E2E_TRUCK_PLATE=
E2E_TRUCK_CHASSIS_PLATE=
